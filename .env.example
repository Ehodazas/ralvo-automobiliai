# Nukopijuokite į .env ir užpildykite. .env neįkeliamas į git.
PORT=8787

# SMTP – per jį siunčiamos užklausos iš svetainės formos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=svetaine@jusu-imone.lt
SMTP_PASS=
MAIL_FROM="Svetainė <svetaine@jusu-imone.lt>"
MAIL_TO=pardavimai@jusu-imone.lt

# true, jei serveris veikia už atvirkštinio tarpinio serverio (Nginx, Caddy, Render ir pan.)
TRUST_PROXY=false

# Laikinai: be SMTP įrašyti užklausas į data/uzklausos.ndjson (tik testavimui)
ENQUIRY_FILE=false
